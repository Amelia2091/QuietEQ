<Window x:Class="QuietEQ.App.EffectEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="编辑 EQ 效果" Width="940" Height="780" MinWidth="780" MinHeight="660" WindowStartupLocation="CenterOwner">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><TextBlock DockPanel.Dock="Right" Text="EQ EFFECT" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="塑造你的声音。" FontSize="24" FontWeight="SemiBold"/></DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="效果名称" Margin="0,0,0,6" Foreground="{StaticResource Muted}"/><TextBox x:Name="EffectName" AutomationProperties.Name="效果名称"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="前级增益 / dB" Margin="0,0,0,6" Foreground="{StaticResource Muted}"/><TextBox x:Name="PreampBox" TextChanged="PreampChanged" AutomationProperties.Name="前级增益"/></StackPanel></Grid>
    <Border Grid.Row="2" Background="#172F2B" CornerRadius="10" Padding="10"><Canvas x:Name="Plot" SizeChanged="PlotChanged" ClipToBounds="True"/></Border>
    <DockPanel Grid.Row="3" Margin="0,12,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="AddBandButton" Content="＋ 频段" Click="AddBand" Padding="12,6" Margin="0,0,6,0"/><Button Content="移除选中" Click="RemoveBand" Padding="12,6"/></StackPanel><StackPanel><TextBlock x:Name="FormatLabel" FontWeight="SemiBold"/><TextBlock Text="参考响应：48 kHz，含前级增益 · 双击单元格编辑" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <DataGrid x:Name="BandsGrid" Grid.Row="4" SelectionMode="Single" CellEditEnding="BandEdited" AutomationProperties.AutomationId="eq-band-grid"/>
    <DockPanel Grid.Row="5" Margin="0,18,0,0"><Button DockPanel.Dock="Right" Content="保存效果" Click="Save" Style="{StaticResource Primary}" Margin="8,0,0,0" AutomationProperties.AutomationId="save-effect"/><Button DockPanel.Dock="Right" Content="取消" IsCancel="True"/><TextBlock Text="保存到效果库后，需应用配置才会改变声音。" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
  </Grid>
</Window>
