<Window x:Class="QuietEQ.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="QuietEQ · Equalizer APO" Width="1280" Height="850" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#172F2B">
      <Grid Margin="18,28,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="16,0,0,35"><TextBlock Text="≋  QuietEQ" FontSize="25" FontWeight="SemiBold" Foreground="#F5F8EF"/><TextBlock Text="A place for every sound." FontSize="10" Foreground="#9AB2A5" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="工作空间" Foreground="#7F9C8D" FontSize="11" Margin="18,0,0,12"/>
          <Button x:Name="DevicesNav" Content="◉     设备" Tag="devices" Click="Navigate" Style="{StaticResource Nav}" AutomationProperties.AutomationId="nav-devices"/>
          <Button x:Name="EffectsNav" Content="≋     EQ 效果库" Tag="effects" Click="Navigate" Style="{StaticResource Nav}" AutomationProperties.AutomationId="nav-effects"/>
          <Button x:Name="ProfilesNav" Content="▤     配置" Tag="profiles" Click="Navigate" Style="{StaticResource Nav}" AutomationProperties.AutomationId="nav-profiles"/>
          <Border Height="1" Background="#304B40" Margin="16,20"/>
          <Button x:Name="AutoNav" Content="⌕     AutoEQ" Tag="autoeq" Click="Navigate" Style="{StaticResource Nav}" AutomationProperties.AutomationId="nav-autoeq"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="12,0">
          <TextBlock Text="为设备设定，然后忘记。" Foreground="#DCE7D9" FontSize="12"/>
          <TextBlock Text="EQ 跟随输出设备。&#10;关闭 QuietEQ 后仍然有效。" Foreground="#8FA99B" FontSize="11" Margin="0,10,0,22" LineHeight="20"/>
          <Button Content="Equalizer APO 设置 ↗" Click="OpenConfigurator" Style="{StaticResource Nav}" FontSize="11" Padding="0,8"/>
          <TextBlock Text="QUIETEQ  /  0.1" Foreground="#698779" FontSize="10" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="34,27,34,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,24">
        <Border DockPanel.Dock="Right" Background="#E7EDE6" CornerRadius="5" Padding="12,6" VerticalAlignment="Center"><TextBlock x:Name="ModeLabel" Text="WINDOWS AUDIO  /  本地" FontSize="10" Foreground="#557263"/></Border>
        <TextBlock Text="音频工作空间" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,25">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="每台设备，都有自己的声音。" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="一次绑定，长期生效。切换输出，EQ 随之切换。" Foreground="{StaticResource Muted}" Margin="0,10,16,0"/></StackPanel>
        <Button x:Name="ApplyTop" Grid.Column="1" Content="预览并应用" Click="ApplyConfig" Style="{StaticResource Primary}" VerticalAlignment="Center" AutomationProperties.AutomationId="apply-config"/>
      </Grid>
      <Grid Grid.Row="2">
        <Grid x:Name="DevicesPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Background="#EAF0E4" BorderBrush="#D6E1CE" Margin="0,0,0,22">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="当前默认输出" Foreground="#5C745C" FontSize="11"/><TextBlock x:Name="DefaultDeviceName" FontSize="20" FontWeight="SemiBold" Margin="0,10,20,8"/><TextBlock x:Name="DefaultBinding" Foreground="#5C745C"/></StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="DeviceCounts" FontSize="14" HorizontalAlignment="Right"/><TextBlock Text="绑定互相独立 · 无需前端常驻" FontSize="11" Foreground="#6A8065" Margin="0,8,0,0"/></StackPanel>
            </Grid>
          </Border>
          <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="刷新设备" Click="RefreshClick" Padding="12,6"/><CheckBox x:Name="ShowOffline" DockPanel.Dock="Right" Content="显示未连接设备" Margin="0,0,16,0" VerticalAlignment="Center" Checked="FilterDevices" Unchecked="FilterDevices"/><TextBlock Text="输出设备" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="DevicesList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#EFF3ED" CornerRadius="8" Width="34" Height="38" VerticalAlignment="Top"><TextBlock Text="♫" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="10,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="{Binding BindingText}" FontSize="12"/><TextBlock Text="{Binding ApoText}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
            <Button Grid.Column="3" Content="绑定 EQ →" Click="BindDevice" Tag="{Binding Device}" Padding="12,8" VerticalAlignment="Center"/>
          </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
        <Grid x:Name="EffectsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="新建 EQ" Click="NewEffect" Margin="0,0,8,0"/><Button Content="导入 .txt" Click="ImportEffect" Style="{StaticResource Primary}" AutomationProperties.AutomationId="import-effect"/></StackPanel><TextBlock x:Name="EffectsCount" FontSize="14" VerticalAlignment="Center"/></DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="EffectsGrid" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="EditEffect"><DataGrid.Columns><DataGridTextColumn Header="EQ 效果" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="2*"/><DataGridTextColumn Header="前级 dB" Binding="{Binding Preamp}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel x:Name="EffectsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380"><TextBlock Text="给声音一个起点。" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="从 AutoEQ 搜索耳机，或导入已有的 EQ 文件。&#10;效果库只保存音色，不绑定任何设备。" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,16,0,24" LineHeight="25"/><Button Content="去 AutoEQ 搜索 →" Tag="autoeq" Click="Navigate" Style="{StaticResource Primary}" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="编辑频段" Click="EditEffect" Margin="0,0,8,0"/><Button Content="复制" Click="DuplicateEffect" Margin="0,0,8,0"/><Button Content="导出 .txt" Click="ExportEffect" Margin="0,0,8,0"/><Button Content="删除" Click="DeleteEffect"/></StackPanel>
        </Grid>
        <Grid x:Name="ProfilesPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="＋ 新建配置" Click="NewProfile" Style="{StaticResource Primary}"/><TextBlock Text="设备 + EQ = 配置。不同设备的配置可同时启用。" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="ProfilesGrid" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="EditProfile"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/><DataGridTextColumn Header="配置" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Windows 设备" Binding="{Binding DeviceName}" Width="2*"/><DataGridTextColumn Header="EQ 效果" Binding="{Binding EffectName}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel x:Name="ProfilesEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400"><TextBlock Text="把设备和音色连起来。" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="为每台常用输出设备选择一个 EQ，&#10;然后「预览并应用」即可固定绑定。" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,16,0,24" LineHeight="25"/><Button Content="创建第一份配置" Click="NewProfile" Style="{StaticResource Primary}" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
          <DockPanel Grid.Row="2" Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="恢复上次应用前的配置" Click="RestoreConfig"/><StackPanel Orientation="Horizontal"><Button Content="编辑绑定" Click="EditProfile" Margin="0,0,8,0"/><Button Content="启用 / 停用" Click="ToggleProfile" Margin="0,0,8,0"/><Button Content="删除" Click="DeleteProfile"/></StackPanel></DockPanel>
        </Grid>
        <Grid x:Name="AutoPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Background="#EAF0E4" BorderBrush="#D6E1CE" Margin="0,0,0,18"><DockPanel><TextBlock DockPanel.Dock="Right" Text="AutoEQ ↗" Foreground="#557263" FontSize="22" FontWeight="Light" VerticalAlignment="Center"/><StackPanel><TextBlock Text="找到耳机，发现它的另一面。" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="搜索 AutoEq 公开目录，下载预计算 EQ 到本地效果库。" Foreground="#657D60" Margin="0,8,20,0"/></StackPanel></DockPanel></Border>
          <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AutoSearch" TextChanged="SearchAutoEq" FontSize="15" ToolTip="输入耳机品牌、型号或测量来源" AutomationProperties.Name="搜索 AutoEQ" AutomationProperties.AutomationId="autoeq-search"/><TextBlock Text="搜索耳机品牌、型号或测量来源…" IsHitTestVisible="False" Foreground="#83918B" Margin="12,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AutoSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button x:Name="RefreshIndex" Grid.Column="1" Content="更新目录" Click="ReloadAutoEq" Margin="10,0,0,0"/></Grid>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="AutoGrid" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="耳机型号 / 测量条件" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="测量来源" Binding="{Binding Source}" Width="*"/></DataGrid.Columns></DataGrid></Border>
          <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="AutoStatus" Text="首次使用需要联网下载目录。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/><DockPanel><Button x:Name="DownloadButton" DockPanel.Dock="Right" Content="下载到效果库 ↓" Click="DownloadEffect" Style="{StaticResource Primary}"/><ComboBox x:Name="DownloadFormat" DockPanel.Dock="Right" SelectedIndex="0" Width="160" Margin="0,0,10,0"><ComboBoxItem Content="Parametric EQ"/><ComboBoxItem Content="Graphic EQ"/></ComboBox><TextBlock Text="选择与耳机状态相符的测量结果。&#10;下载后在「配置」中绑定设备。" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></StackPanel>
        </Grid>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="配置目录" Click="ChooseConfigDirectory" Padding="8,3" FontSize="10" Margin="12,0,0,0"/><TextBlock x:Name="StatusText" Text="正在读取设备…" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
